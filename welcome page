<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - BitInvest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            font-family: 'Inter', sans-serif;
        }
        .login-card {
            background: rgba(30, 41, 59, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .glow-btn {
            background: linear-gradient(45deg, #f59e0b, #d97706);
            box-shadow: 0 0 20px rgba(245, 158, 11, 0.5);
            transition: all 0.3s ease;
        }
        .glow-btn:hover {
            box-shadow: 0 0 30px rgba(245, 158, 11, 0.8);
            transform: translateY(-2px);
        }
        .bitcoin-glow {
            animation: glow 2s ease-in-out infinite alternate;
        }
        @keyframes glow {
            from { box-shadow: 0 0 10px #f59e0b; }
            to { box-shadow: 0 0 20px #f59e0b, 0 0 30px #f59e0b; }
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center">
    <!-- Logo -->
    <div class="absolute top-8 left-1/2 transform -translate-x-1/2">
        <img src="https://storage.googleapis.com/workspace-0f70711f-8b4e-4d94-86f1-2a93ccde5887/image/aacc5ac0-4771-4860-9ed9-77b9d81c4dd8.png" alt="BitInvest Logo" class="w-12 h-12 mx-auto mb-2">
        <h1 class="text-2xl font-bold text-white text-center">BitInvest</h1>
        <style>
            .logo-animation {
    animation: spin-glow 4s linear infinite; /* Slow, continuous spin with glow */
}

@keyframes spin-glow {
    0% {
        transform: rotate(0deg);
        filter: drop-shadow(0 0 5px #f59e0b);
    }
    50% {
        filter: drop-shadow(0 0 15px #f59e0b); /* Peak glow */
    }
    100% {
        transform: rotate(360deg);
        filter: drop-shadow(0 0 5px #f59e0b);
    }
}

        </style>
    </div>

    <!-- Login Card -->
    <div class="login-card rounded-xl p-8 w-full max-w-md shadow-2xl">
        <h2 class="text-2xl font-bold text-white text-center mb-6">Welcome Back to BitInvest</h2>
        
        <form id="login-form" class="space-y-4">
            <div>
                <label for="email" class="block text-sm font-medium text-gray-300 mb-1">Email or Username</label>
                <input type="text" id="email" class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-yellow-500" placeholder="Enter your email" required>
            </div>
            <div>
                <label for="password" class="block text-sm font-medium text-gray-300 mb-1">Password</label>
                <input type="password" id="password" class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-yellow-500" placeholder="Enter your password" required>
            </div>
            <button type="submit" class="glow-btn w-full py-3 rounded-lg font-semibold text-black">Login</button>
        </form>
        
        <div class="mt-4 text-center">
            <a href="#" class="text-sm text-yellow-400 hover:text-yellow-300">Forgot Password?</a>
        </div>
        
        <div class="mt-6 flex items-center">
            <hr class="flex-1 border-gray-600">
            <span class="px-3 text-sm text-gray-400">or</span>
            <hr class="flex-1 border-gray-600">
        </div>
        
        <div class="mt-4 text-center">
            <p class="text-sm text-gray-300">Don’t have an account? <a href="signup.html" class="text-yellow-400 hover:text-yellow-300 font-semibold">Sign Up</a></p>
        </div>
    </div>

    <!-- Bitcoin Price Ticker -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 text-center">
        <div class="bitcoin-glow inline-block p-2 rounded-lg bg-gray-800">
            <i class="fab fa-btc text-yellow-400 mr-2"></i>
            <span class="text-white font-semibold">BTC: $60,000 <span class="text-green-400">+2.5%</span></span>
        </div>
    </div>

    <script>
        // Mock login functionality (replace with real auth)
        document.getElementById('login-form').addEventListener('submit', (e) => {
            e.preventDefault();
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            if (email && password) {
                alert('Login successful! Redirecting to dashboard...');
                // Redirect to dashboard (replace with actual dashboard URL)
            } else {
                alert('Please fill in all fields.');
            }
        });

        // Mock price update
        setInterval(() => {
            const price = (60000 + Math.random() * 1000).toFixed(0);
            document.querySelector('.bitcoin-glow span').innerHTML = `BTC: $${price} <span class="text-green-400">+${(Math.random() * 5).toFixed(1)}%</span>`;
        }, 5000);
    </script>
    
</body>
</html>
